# Axion sample script — Gel
#
# Spins the GameObject this script is attached to.
# Lifecycle hooks: start() runs once when the scene loads, loop() runs every frame.
# Top-level statements (outside any function) also run at start.

speed = 90.0

func start() {
    print("cube spawned at " + Transform.Position)
}

func loop() {
    Transform.Rotate(Vec.V(0, speed * Time.DeltaTime, 0))
}
